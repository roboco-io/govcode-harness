{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://govcode.example.invalid/contracts/snapshot.schema.json",
  "title": "GovCode tracked commit snapshot manifest",
  "description": "Source-free inventory. Python source classification means eligible detector input, not proof of complete AST analysis. Supporting files are not analyzed. Collection and runtime enforce counts, digest, sorted uniqueness, and total size invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "commit_sha",
    "scope",
    "inventory_digest",
    "files",
    "total_bytes",
    "supported_files",
    "issues"
  ],
  "properties": {
    "format": {
      "const": "govcode-snapshot-v1"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "scope": {
      "const": "all_tracked_files_at_commit"
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "classification",
          "reason_code"
        ],
        "properties": {
          "path": {
            "$ref": "#/definitions/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "classification": {
            "enum": [
              "python_source",
              "supporting_file",
              "unsupported_file",
              "encoding_error"
            ]
          },
          "reason_code": {
            "enum": [
              "PYTHON_SOURCE",
              "SUPPORTING_FILE_NOT_ANALYZED",
              "UNSUPPORTED_FILE_TYPE",
              "SOURCE_ENCODING_ERROR"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "python_source"
                }
              }
            },
            "then": {
              "properties": {
                "reason_code": {
                  "const": "PYTHON_SOURCE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "supporting_file"
                }
              }
            },
            "then": {
              "properties": {
                "reason_code": {
                  "const": "SUPPORTING_FILE_NOT_ANALYZED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "unsupported_file"
                }
              }
            },
            "then": {
              "properties": {
                "reason_code": {
                  "const": "UNSUPPORTED_FILE_TYPE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "encoding_error"
                }
              }
            },
            "then": {
              "properties": {
                "reason_code": {
                  "const": "SOURCE_ENCODING_ERROR"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "supported_files": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "code"
        ],
        "properties": {
          "path": {
            "anyOf": [
              {
                "const": "."
              },
              {
                "$ref": "#/definitions/path"
              }
            ]
          },
          "line": {
            "const": 1
          },
          "code": {
            "enum": [
              "SOURCE_ENCODING_ERROR",
              "UNSUPPORTED_FILE_TYPE",
              "NO_SUPPORTED_SOURCE"
            ]
          }
        }
      },
      "uniqueItems": true
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*?/$)[^\\\\\\x00-\\x1f\\x7f]+$"
    }
  }
}
